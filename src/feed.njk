---
permalink: feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/"/>
  <link rel="self" href="{{ site.url }}/feed.xml" type="application/atom+xml"/>
  <updated>{{ collections.postList | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  {%- for p in collections.postList.slice(0, 20) %}
  <entry>
    <title>{{ p.data.title }}</title>
    <link href="{{ site.url }}{{ p.url }}"/>
    <updated>{{ p.date | dateToRfc3339 }}</updated>
    <id>{{ site.url }}{{ p.url }}</id>
    <summary>{{ p.data.desc }}</summary>
  </entry>
  {%- endfor %}
</feed>
