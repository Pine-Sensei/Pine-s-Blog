{% extends "base.njk" %}
{% block title %}{{ title }} — {{ site.title }}{% endblock %}
{% block content %}
<h1><a href="/">索引</a> » {{ title }}</h1>
<dl>
  {% for p in collections[category] %}
  <dt><a href="{{ p.url }}">{{ p.data.title }}</a></dt>
  <dd class="small">{{ p.data.date | isoDate }} — {{ p.data.desc }}</dd>
  {% endfor %}
</dl>
<p class="small"><a href="/">返回索引</a></p>
{% endblock %}
